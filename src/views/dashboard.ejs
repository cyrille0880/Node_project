<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                    <p><%= project.location %> | <%= project.date %></p>
                    <p>Hosted by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit">Remove volunteer signup</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects yet.</p>
        <p><a href="/projects">Browse upcoming service projects</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>