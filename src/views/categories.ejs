
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p>Browse service projects by category:</p>
    <ul class="category-list">
        <% if (categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li><strong><%= category.category_name %></strong>: <%= category.project_title %></li>
            <% }); %>
        <% } else { %>
            <li>No project categories found.</li>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>