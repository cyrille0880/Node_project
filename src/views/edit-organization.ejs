<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

    <form action="/edit-organization/<%= organization.organization_id %>" method="POST" class="form-panel">
        <div class="form-group">
            <label for="name">Organization name</label>
            <input type="text" id="name" name="name" value="<%= organization.name %>" maxlength="150" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" required><%= organization.description %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact email</label>
            <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>" maxlength="255" required>
        </div>

        <button type="submit">Save Changes</button>
        <a href="/organization/<%= organization.organization_id %>">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>