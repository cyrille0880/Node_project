<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project title</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="255" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description"><%= project.description || '' %></textarea>
        </div>

        <div class="form-group">
            <label for="date">Project date</label>
            <input type="date" id="date" name="date" value="<%= project.date %>" required>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="255" required>
        </div>

        <div class="form-group">
            <label for="organization_id">Partner organization</label>
            <select id="organization_id" name="organization_id" required>
                <% organizations.forEach(organization => { %>
                    <option value="<%= organization.organization_id %>" <%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>>
                        <%= organization.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Save Changes</button>
        <a href="/project/<%= project.project_id %>">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>