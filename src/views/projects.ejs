<%- include('partials/header') %>   
    <main>
        <h1><%= title %></h1>
        
        <p>Upcoming service projects and their partner organizations.</p>
        <p><a href="/new-project">Create a Service Project</a></p>
        <ul class="project-list">

            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>: <%= project.location %>: <%= project.date %> (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</li>
            <% }); %>
        </ul>
    </main>

<%- include('partials/footer') %>